{
  "name": "@inixiative/kcp",
  "version": "0.1.0",
  "description": "KCP, the Kingdom CLI proxy: sign in to Kingdom once, then run CLI commands as typed Signet operations Kingdom executes with the credential it holds.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "kcp": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run check",
    "lint": "biome check .",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi"
  },
  "keywords": [
    "kingdom",
    "signet",
    "cli",
    "proxy",
    "credentials"
  ],
  "license": "MIT",
  "dependencies": {
    "@inixiative/signet": "^0.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.183",
    "@types/bun": "1.4.4",
    "lefthook": "2.1.9",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/kcp.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
